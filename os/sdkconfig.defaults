CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Waveshare 4.3C carries an ESP32-S3-WROOM-1-N16R8: 16MB flash, 8MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# esp-matter requires the mbedtls HKDF module for CHIP key derivation
CONFIG_MBEDTLS_HKDF_C=y
# LVGL (touch UI): RGB565 panel; keep the default builtin LVGL allocator
CONFIG_LV_COLOR_DEPTH_16=y
